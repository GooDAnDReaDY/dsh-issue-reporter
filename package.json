{
  "name": "@goodandready/dsh-issue-reporter",
  "version": "0.1.2",
  "description": "Preview and submit actionable GitHub bug reports from DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./domain": "./lib/domain.js",
    "./github": "./lib/github.js",
    "./package.json": "./package.json",
    "./plugin-updater": "./lib/plugin-updater.js"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "scripts": {
    "prepack": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-issue-reporter.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-issue-reporter#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-issue-reporter/issues"
  }
}
